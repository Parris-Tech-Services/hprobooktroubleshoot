<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WindowsCrashDoctor</AssemblyName>
    <RootNamespace>WindowsCrashDoctor</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishTrimmed>false</PublishTrimmed>
    <Version>0.3.0-preview.2</Version>
    <FileVersion>0.3.0.0</FileVersion>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <InformationalVersion Condition="'$(SourceRevisionId)' != ''">0.3.0-preview.2+$(SourceRevisionId)</InformationalVersion>
    <InformationalVersion Condition="'$(SourceRevisionId)' == ''">0.3.0-preview.2+local</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../docs/TOOLKIT_CATALOG.html" LogicalName="WCD.Toolkit.Catalog.html" />
    <EmbeddedResource Include="../../windows-crash-doctor/integrations/toolkit.tsv" LogicalName="WCD.Toolkit.Data.tsv" />
    <EmbeddedResource Include="../../windows-crash-doctor/integrations/toolkit-actions.json" LogicalName="WCD.Toolkit.Actions.json" />
    <EmbeddedResource Include="../../scripts/collect-diagnostics.ps1" LogicalName="WCD.Engine.scripts.collect-diagnostics.ps1" />
    <EmbeddedResource Include="../../scripts/check-public-evidence.ps1" LogicalName="WCD.Engine.scripts.check-public-evidence.ps1" />
    <EmbeddedResource Include="../../windows-crash-doctor/CrashDoctor.psm1" LogicalName="WCD.Engine.windows-crash-doctor.CrashDoctor.psm1" />
    <EmbeddedResource Include="../../windows-crash-doctor/TelemetryAnalysis.psm1" LogicalName="WCD.Engine.windows-crash-doctor.TelemetryAnalysis.psm1" />
    <EmbeddedResource Include="../../windows-crash-doctor/DumpParser.psm1" LogicalName="WCD.Engine.windows-crash-doctor.DumpParser.psm1" />
    <EmbeddedResource Include="../../windows-crash-doctor/Invoke-CrashDoctor.ps1" LogicalName="WCD.Engine.windows-crash-doctor.Invoke-CrashDoctor.ps1" />
    <EmbeddedResource Include="../../windows-crash-doctor/NetworkDoctor.ps1" LogicalName="WCD.Engine.windows-crash-doctor.NetworkDoctor.ps1" />
    <EmbeddedResource Include="../../windows-crash-doctor/DiagnosticRegistry.psm1" LogicalName="WCD.Engine.windows-crash-doctor.DiagnosticRegistry.psm1" />
    <EmbeddedResource Include="../../windows-crash-doctor/diagnostics/registry.json" LogicalName="WCD.Engine.windows-crash-doctor.diagnostics.registry.json" />
    <EmbeddedResource Include="../../windows-crash-doctor/Integrations.psm1" LogicalName="WCD.Engine.windows-crash-doctor.Integrations.psm1" />
    <EmbeddedResource Include="../../windows-crash-doctor/Manage-Integrations.ps1" LogicalName="WCD.Engine.windows-crash-doctor.Manage-Integrations.ps1" />
    <EmbeddedResource Include="../../windows-crash-doctor/version.json" LogicalName="WCD.Engine.windows-crash-doctor.version.json" />
    <EmbeddedResource Include="../../windows-crash-doctor/integrations/catalog.json" LogicalName="WCD.Engine.windows-crash-doctor.integrations.catalog.json" />
    <EmbeddedResource Include="../../windows-crash-doctor/WerDoctor.psm1" LogicalName="WCD.Engine.windows-crash-doctor.WerDoctor.psm1" />
    <EmbeddedResource Include="../../windows-crash-doctor/SymbolServer.psm1" LogicalName="WCD.Engine.windows-crash-doctor.SymbolServer.psm1" />
  </ItemGroup>
</Project>
