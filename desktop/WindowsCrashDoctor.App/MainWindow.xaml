<Window x:Class="WindowsCrashDoctor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Crash Doctor"
        Width="1280" Height="820" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBackground}" Padding="18,22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <Border Width="46" Height="46" CornerRadius="13" Background="#2563EB" HorizontalAlignment="Left">
                        <Grid><TextBlock Text="✚" FontSize="23" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                    </Border>
                    <TextBlock Text="Windows Crash Doctor" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0"/>
                    <TextBlock Text="Evidence-first diagnostics" Foreground="#8FA1BA" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Style="{StaticResource NavButton}" Background="{DynamicResource SidebarSelected}" Click="DashboardNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="●" Margin="0,0,11,0"/><TextBlock Text="Dashboard"/></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Click="DiagnosticsNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Margin="0,0,11,0"/><TextBlock Text="Diagnostics"/></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Click="SensorsNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⌁" Margin="0,0,11,0"/><TextBlock Text="Live Sensors"/></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Click="HistoryNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="◷" Margin="0,0,11,0"/><TextBlock Text="History"/></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Click="IntegrationsNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="◇" Margin="0,0,11,0"/><TextBlock Text="Integrations"/></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Click="NetworkNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⌁" Margin="0,0,11,0"/><TextBlock Text="Network Doctor"/></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Click="SettingsNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Margin="0,0,11,0"/><TextBlock Text="Settings"/></StackPanel></Button>
                </StackPanel>

                <Border Grid.Row="3" CornerRadius="12" Background="#121D31" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Diagnostic engine" Foreground="#90A4C0" FontSize="11"/>
                        <TextBlock Text="v0.3.0 Preview" Foreground="White" FontWeight="SemiBold" Margin="0,3,0,0"/>
                        <TextBlock x:Name="AdminStatusText" Text="Checking permissions…" Foreground="#90A4C0" FontSize="11" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1" Padding="30,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="System Dashboard" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}"/>
                        <TextBlock x:Name="PageSubtitle" Text="Live health and the latest diagnostic evidence" FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="12,7" Margin="0,0,10,0"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{DynamicResource Good}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock x:Name="LiveStatusText" Text="Live" Foreground="{DynamicResource PrimaryText}" FontWeight="SemiBold" FontSize="12"/></StackPanel></Border>
                        <Button x:Name="ThemeButton" Style="{StaticResource SecondaryButton}" Click="ThemeButton_Click" Content="Dark mode"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0" SelectedIndex="0">
                <TabControl.Resources><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.Resources>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,26,30,35">
                        <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Your PC at a glance" Foreground="{DynamicResource SecondaryText}" FontSize="12"/><TextBlock x:Name="HealthHeadline" Text="Ready for a diagnostic run" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock x:Name="HealthExplanation" Text="Run a full diagnosis to turn Windows logs, firmware state and hardware telemetry into a ranked evidence report." Foreground="{DynamicResource SecondaryText}" FontSize="13" TextWrapping="Wrap" MaxWidth="690" Margin="0,9,0,0"/></StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource SecondaryButton}" Click="OpenLatestReport_Click" Content="Open last report" Margin="0,0,10,0"/><Button Style="{StaticResource PrimaryButton}" Click="RunFullDiagnosis_Click" Content="Run Full Diagnosis"/></StackPanel>
                        </Grid></Border>

                        <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="CPU" Foreground="{DynamicResource SecondaryText}"/><TextBlock x:Name="CpuValue" Text="0%" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,5"/><ProgressBar x:Name="CpuBar" Height="6" Minimum="0" Maximum="100" Value="0" Foreground="#2563EB" Background="{DynamicResource AccentSoft}" BorderThickness="0"/></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="4,0,8,0"><StackPanel><TextBlock Text="Memory" Foreground="{DynamicResource SecondaryText}"/><TextBlock x:Name="MemoryValue" Text="0%" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,5"/><ProgressBar x:Name="MemoryBar" Height="6" Minimum="0" Maximum="100" Value="0" Foreground="#7C3AED" Background="#F1EBFF" BorderThickness="0"/></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,4,0"><StackPanel><TextBlock Text="CPU temperature" Foreground="{DynamicResource SecondaryText}"/><TextBlock x:Name="CpuTempValue" Text="—" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,5"/><TextBlock Text="Sensor availability varies by firmware" Foreground="{DynamicResource MutedText}" FontSize="10"/></StackPanel></Border>
                            <Border Grid.Column="3" Style="{StaticResource Card}" Margin="12,0,0,0"><StackPanel><TextBlock Text="SSD temperature" Foreground="{DynamicResource SecondaryText}"/><TextBlock x:Name="SsdTempValue" Text="—" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,5"/><TextBlock Text="Windows reliability counter" Foreground="{DynamicResource MutedText}" FontSize="10"/></StackPanel></Border>
                        </Grid>

                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,9,0"><StackPanel><DockPanel Margin="0,0,0,14"><TextBlock Text="Latest evidence" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="FindingCountText" DockPanel.Dock="Right" Text="No report yet" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/></DockPanel>
                                <ItemsControl x:Name="DashboardFindings"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0" Padding="0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="88"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{Binding SeverityBackground}" CornerRadius="7" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock Text="{Binding Severity}" Foreground="{Binding SeverityBrush}" FontWeight="SemiBold" FontSize="11"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Interpretation}" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel></Border>
                            <StackPanel Grid.Column="1" Margin="9,0,0,0"><Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Recommended next action" Foreground="{DynamicResource SecondaryText}" FontSize="12"/><TextBlock x:Name="RecommendationTitle" Text="Run a full diagnosis" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0" TextWrapping="Wrap"/><TextBlock x:Name="RecommendationBody" Text="Crash Doctor will choose the highest-priority evidence-backed next step." Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
                                <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Machine" Foreground="{DynamicResource SecondaryText}" FontSize="12"/><TextBlock x:Name="MachineModelText" Text="Not captured yet" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,0"/><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="BIOS" Foreground="{DynamicResource MutedText}" FontSize="10"/><TextBlock x:Name="BiosText" Text="—" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="RAM" Foreground="{DynamicResource MutedText}" FontSize="10"/><TextBlock x:Name="RamText" Text="—" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Grid></StackPanel></Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel></ScrollViewer>
                </TabItem>

                <TabItem>
                    <Grid Margin="30,26,30,35"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Full system diagnosis" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Read-only collection → evidence analysis → ranked findings → report." Foreground="{DynamicResource SecondaryText}" Margin="0,5,0,12"/><ProgressBar x:Name="DiagnosticProgress" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="{DynamicResource Accent}" Background="{DynamicResource AccentSoft}" BorderThickness="0"/><TextBlock x:Name="DiagnosticStatusText" Text="Ready" Foreground="{DynamicResource SecondaryText}" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0"><Button Style="{StaticResource SecondaryButton}" Click="AnalyseDump_Click" Content="Analyse .dmp" Margin="0,0,10,0"/><Button x:Name="RunDiagnosisButton" Style="{StaticResource PrimaryButton}" Click="RunFullDiagnosis_Click" Content="Run Full Diagnosis"/></StackPanel></Grid></Border>
                        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="0.75*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,9,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Live diagnostic log" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBox x:Name="DiagnosticLog" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SecondaryText}" FontFamily="Consolas" FontSize="11"/></ScrollViewer></DockPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="9,0,0,0"><StackPanel><TextBlock Text="What Crash Doctor checks" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="✓ Firmware and PnP state" Margin="0,5"/><TextBlock Text="✓ Windows image provenance" Margin="0,5"/><TextBlock Text="✓ Storage reliability" Margin="0,5"/><TextBlock Text="✓ RAM and dump readiness" Margin="0,5"/><TextBlock Text="✓ Power / sleep state" Margin="0,5"/><TextBlock Text="✓ Kernel-Power / WHEA events" Margin="0,5"/><TextBlock Text="✓ OEM / tuning drivers" Margin="0,5"/><TextBlock Text="✓ Native minidump headers" Margin="0,5"/><Border Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="12" Margin="0,18,0,0"><TextBlock Text="No BIOS flashing, driver removal or BitLocker changes are performed by the diagnostic run." Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" FontSize="11"/></Border></StackPanel></Border></Grid>
                    </Grid>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,26,30,35"><Border Style="{StaticResource Card}" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Live system telemetry" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Low-overhead CPU and memory sampling plus periodic temperature checks." Foreground="{DynamicResource SecondaryText}" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" x:Name="DeepSensorButton" Style="{StaticResource PrimaryButton}" Click="DeepSensorButton_Click" Content="Start 30-min Deep Sensor Log"/></Grid></Border>
                        <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,9,0"><StackPanel><TextBlock Text="CPU usage" Foreground="{DynamicResource SecondaryText}"/><TextBlock x:Name="SensorCpuValue" Text="0%" FontSize="32" FontWeight="SemiBold" Margin="0,8,0,8"/><ProgressBar x:Name="SensorCpuBar" Height="9" Maximum="100" Foreground="#2563EB" Background="{DynamicResource AccentSoft}" BorderThickness="0"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="3,0,6,0"><StackPanel><TextBlock Text="Memory usage" Foreground="{DynamicResource SecondaryText}"/><TextBlock x:Name="SensorMemoryValue" Text="0%" FontSize="32" FontWeight="SemiBold" Margin="0,8,0,8"/><ProgressBar x:Name="SensorMemoryBar" Height="9" Maximum="100" Foreground="#7C3AED" Background="#F1EBFF" BorderThickness="0"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}" Margin="6,0,3,0"><StackPanel><TextBlock Text="CPU temperature" Foreground="{DynamicResource SecondaryText}"/><TextBlock x:Name="SensorCpuTemp" Text="—" FontSize="32" FontWeight="SemiBold" Margin="0,8,0,8"/><TextBlock Text="ACPI / provider dependent" Foreground="{DynamicResource MutedText}" FontSize="10"/></StackPanel></Border><Border Grid.Column="3" Style="{StaticResource Card}" Margin="9,0,0,0"><StackPanel><TextBlock Text="SSD temperature" Foreground="{DynamicResource SecondaryText}"/><TextBlock x:Name="SensorSsdTemp" Text="—" FontSize="32" FontWeight="SemiBold" Margin="0,8,0,8"/><TextBlock Text="Storage reliability counter" Foreground="{DynamicResource MutedText}" FontSize="10"/></StackPanel></Border></Grid>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Deep freeze capture" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="The deep sensor log uses LibreHardwareMonitor when available and records JSONL samples that can survive right up to a hard lock. It is optional so it does not silently change your test conditions." Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,7,0,12"/><TextBlock x:Name="DeepSensorStatusText" Text="Not running" Foreground="{DynamicResource SecondaryText}"/><ProgressBar x:Name="DeepSensorProgress" Height="7" Maximum="100" Value="0" Margin="0,10,0,0" Foreground="{DynamicResource Good}" Background="{DynamicResource GoodSoft}" BorderThickness="0"/></StackPanel></Border>
                    </StackPanel></ScrollViewer>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,26,30,35"><Border Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,0,0,14"><StackPanel><TextBlock Text="Diagnostic history" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Previous runs stay local on this PC." Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0"/></StackPanel><Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Click="RefreshHistory_Click" Content="Refresh"/></DockPanel><ItemsControl x:Name="HistoryList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0" Padding="0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding WhenText}" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding HealthLabel}" FontWeight="SemiBold"/><TextBlock Text="{Binding SummaryText}" Foreground="{DynamicResource SecondaryText}" FontSize="11" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Model}" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock x:Name="NoHistoryText" Text="No diagnostic runs yet." Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Center" Margin="0,35"/></StackPanel></Border></StackPanel></ScrollViewer>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,26,30,35"><Border Style="{StaticResource Card}" Margin="0,0,0,18"><DockPanel><StackPanel><TextBlock Text="Open-source diagnostic providers" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Verified adapters extend Crash Doctor without silently installing privileged tools." Foreground="{DynamicResource SecondaryText}" Margin="0,5,0,0"/></StackPanel><Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Click="RefreshIntegrations_Click" Content="Refresh status"/></DockPanel></Border>
                        <UniformGrid Columns="2"><Border Style="{StaticResource Card}" Margin="0,0,9,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="LibreHardwareMonitor" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Temperatures, clocks, voltages and load telemetry." Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Tag="librehardwaremonitor" Style="{StaticResource SecondaryButton}" Click="InstallIntegration_Click" Content="Install" Margin="14,0,0,0"/></Grid></Border><Border Style="{StaticResource Card}" Margin="9,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="evtx_dump" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Fast deterministic EVTX → JSONL conversion." Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Tag="evtx" Style="{StaticResource SecondaryButton}" Click="InstallIntegration_Click" Content="Install" Margin="14,0,0,0"/></Grid></Border><Border Style="{StaticResource Card}" Margin="0,0,9,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Hayabusa" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Forensic Windows event timeline and Sigma enrichment." Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Tag="hayabusa" Style="{StaticResource SecondaryButton}" Click="InstallIntegration_Click" Content="Install" Margin="14,0,0,0"/></Grid></Border><Border Style="{StaticResource Card}" Margin="9,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="osquery" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Structured read-only driver, service and machine inventory." Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Tag="osquery" Style="{StaticResource SecondaryButton}" Click="InstallIntegration_Click" Content="Install" Margin="14,0,0,0"/></Grid></Border><Border Style="{StaticResource Card}" Margin="0,0,9,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PerfView" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Advanced ETW tracing for targeted escalation." Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Tag="perfview" Style="{StaticResource SecondaryButton}" Click="InstallIntegration_Click" Content="Install" Margin="14,0,0,0"/></Grid></Border><Border Style="{StaticResource Card}" Margin="9,0,0,12"><StackPanel><TextBlock Text="Boot / firmware tools" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Memtest86+ and CHIPSEC remain manual by design because they reboot or operate at privileged firmware level." Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border></UniformGrid>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Provider status" FontSize="16" FontWeight="SemiBold"/><TextBox x:Name="IntegrationStatusText" Margin="0,10,0,0" MinHeight="110" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SecondaryText}"/></StackPanel></Border>
                    </StackPanel></ScrollViewer>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="30,26,30,35"><Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Use a light or dark workspace. Diagnostic evidence is unaffected." Foreground="{DynamicResource SecondaryText}" Margin="0,5,0,12"/><Button Style="{StaticResource SecondaryButton}" Click="ThemeButton_Click" Content="Toggle light / dark mode" HorizontalAlignment="Left"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Evidence and privacy" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Diagnostic folders can contain usernames, hardware identifiers, network details, EVTX records and other sensitive material. Crash Doctor stores them locally and never uploads them automatically." Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,12"/><StackPanel Orientation="Horizontal"><Button Style="{StaticResource SecondaryButton}" Click="OpenResultsFolder_Click" Content="Open results folder" Margin="0,0,10,0"/><Button Style="{StaticResource SecondaryButton}" Click="ExportPrivacyReviewedBundle_Click" Content="Export privacy-reviewed bundle"/></StackPanel></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="About" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Windows Crash Doctor Desktop Preview 0.3.0" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="Built around an evidence-first rule engine: observation, inherited image history, interpretation and causality stay separate." Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
                </TabItem>
            
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="30,26,30,35">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Network Doctor" FontSize="20" FontWeight="SemiBold"/>
                                        <TextBlock Text="One-click evidence-first triage for DHCP, duplicate IPs, DNS, HTTPS, proxy, VPN/filter services and browser-vs-network failures." Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,5,0,12" MaxWidth="720"/>
                                        <ProgressBar x:Name="NetworkProgress" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="{DynamicResource Accent}" Background="{DynamicResource AccentSoft}" BorderThickness="0"/>
                                        <TextBlock x:Name="NetworkStatusText" Text="Ready" Foreground="{DynamicResource SecondaryText}" Margin="0,7,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                        <Button x:Name="OpenNetworkReportButton" Style="{StaticResource SecondaryButton}" Click="OpenNetworkReport_Click" Content="Open report" Margin="0,0,10,0" IsEnabled="False"/>
                                        <Button x:Name="RefreshNetworkButton" Style="{StaticResource SecondaryButton}" Click="RefreshNetwork_Click" Content="Refresh DHCP + DNS" Margin="0,0,10,0"/>
                                        <Button x:Name="RunNetworkDoctorButton" Style="{StaticResource PrimaryButton}" Click="RunNetworkDoctor_Click" Content="Run Network Doctor"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,9,0">
                                    <StackPanel>
                                        <TextBlock Text="Diagnosis" FontSize="17" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="NetworkSummaryText" Text="Run Network Doctor to automatically work through the same checks used in manual troubleshooting." FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                        <TextBlock Text="Recommended next action" Foreground="{DynamicResource SecondaryText}" FontSize="12" Margin="0,18,0,0"/>
                                        <TextBlock x:Name="NetworkNextStepText" Text="No diagnosis yet." Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="9,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="What it checks" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                        <TextBlock Text="✓ Active adapter, link speed and IPv4 state" Margin="0,4"/>
                                        <TextBlock Text="✓ DHCP vs APIPA (169.254.x.x)" Margin="0,4"/>
                                        <TextBlock Text="✓ Duplicate-IP Event 4199 and MAC patterns" Margin="0,4"/>
                                        <TextBlock Text="✓ Gateway and public-IP reachability" Margin="0,4"/>
                                        <TextBlock Text="✓ Configured DNS vs direct public DNS" Margin="0,4"/>
                                        <TextBlock Text="✓ Local loopback DNS/filter listener ownership" Margin="0,4"/>
                                        <TextBlock Text="✓ HTTPS, IPv4/IPv6 and TCP 443" Margin="0,4"/>
                                        <TextBlock Text="✓ WinHTTP/user proxy and hosts overrides" Margin="0,4"/>
                                        <TextBlock Text="✓ VPN/DNS/filter services and stale static profiles" Margin="0,4"/>
                                        <TextBlock Text="✓ Wi-Fi SSIDs, profiles, drivers and auth events" Margin="0,4"/>
                                        <TextBlock Text="✓ Captive portal, default routes and time sync" Margin="0,4"/>
                                        <Border Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="12" Margin="0,14,0,0">
                                            <TextBlock Text="Diagnosis is read-only. Refresh DHCP + DNS is a separate explicit action and does not force DNS servers, reset Winsock, disable security software or assign a static IP." Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" FontSize="11"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Network diagnostic log" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Height="240">
                                        <TextBox x:Name="NetworkLog" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource SecondaryText}" FontFamily="Consolas" FontSize="11"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
</TabControl>
        </Grid>
    </Grid>
